@model Barbina.UI.ViewModels.CategoriaViewModel
@{ ViewData["Title"] = "Nova Categoria"; Layout = "_AdminLayout"; }

<div class="card" style="max-width:600px;">
    <div class="card-header"><h3><i class="fas fa-folder-plus" style="margin-right:10px;"></i>Nova Categoria</h3></div>
    <div class="card-body">
        <form asp-action="Criar" asp-controller="Categorias" method="post" enctype="multipart/form-data">
            @Html.AntiForgeryToken()
            <div asp-validation-summary="ModelOnly" style="color:#dc3545;margin-bottom:16px;font-size:14px;"></div>
            <div class="form-group">
                <label asp-for="Nome">Nome da Categoria *</label>
                <input asp-for="Nome" placeholder="Ex: Entradas">
                <span asp-validation-for="Nome" style="color:#dc3545;font-size:12px;"></span>
            </div>
            <div class="form-group">
                <label asp-for="Cor">Cor (rgba)</label>
                <input asp-for="Cor" placeholder="rgba(154,132,86,1)">
                <span asp-validation-for="Cor" style="color:#dc3545;font-size:12px;"></span>
            </div>
            <div class="form-group">
                <label asp-for="Foto">Foto da Categoria</label>
                <input asp-for="Foto" type="file" accept="image/*">
            </div>
            <div style="display:flex;gap:12px;margin-top:8px;">
                <button type="submit" class="btn-primary"><i class="fas fa-save"></i> Salvar</button>
                <a href="/admin/categorias" class="btn-secondary">Cancelar</a>
            </div>
        </form>
    </div>
</div>
