@{ ViewData["Title"] = "Reservas"; Layout = "_Layout"; }
<section class="hero-page reserva-hero" style="background-image: linear-gradient(rgba(0,0,0,0.72), rgba(0,0,0,0.72)), url('https://images.unsplash.com/photo-1555396273-367ea4eb4db5?auto=format&fit=crop&w=1920&q=80');">
    <div class="hero-content reserva-hero__inner">
        <p class="reserva-hero__eyebrow">Reserve sua mesa</p>
        <h2>Faça sua Reserva</h2>
        <p class="reserva-hero__lead">Garanta sua mesa para uma experiência inesquecível no Barbina.</p>
    </div>
</section>
<section class="reserva-form">
    <div class="container container--narrow">
        <div class="reserva-strip anim-fade-up">
            <div class="reserva-strip__item"><i class="fas fa-clock"></i><span>Qua–sáb 17h–23:30 · Dom 11h–15h</span></div>
            <div class="reserva-strip__item"><i class="fas fa-phone"></i><span>(14) 3438-1255</span></div>
        </div>
        <div class="form-container form-container--reserva anim-fade-up">
            <header class="form-head">
                <h2>Detalhes da reserva</h2>
                <p class="form-head__sub">Preencha o formulário. Confirmaremos por telefone ou e-mail.</p>
            </header>
            <form id="reservaForm">
                <div class="form-row">
                    <div class="form-group"><label for="nome">Nome completo</label><input type="text" id="nome" name="nome" placeholder="Seu nome completo" required></div>
                    <div class="form-group"><label for="telefone">Telefone</label><input type="tel" id="telefone" name="telefone" placeholder="(14) 99999-9999" required></div>
                </div>
                <div class="form-group"><label for="email">E-mail</label><input type="email" id="email" name="email" placeholder="seu.email@exemplo.com" required></div>
                <div class="form-group">
                    <span class="label-like" id="label-tipo-reserva">Tipo de reserva</span>
                    <div class="radio-cards" role="radiogroup" aria-labelledby="label-tipo-reserva">
                        <label class="radio-card"><input type="radio" name="tipoReserva" value="comum" checked><span class="radio-card__body"><span class="radio-card__title">Mesa</span><span class="radio-card__hint">Almoço ou jantar</span></span></label>
                        <label class="radio-card"><input type="radio" name="tipoReserva" value="evento"><span class="radio-card__body"><span class="radio-card__title">Evento</span><span class="radio-card__hint">Grupos e ocasiões especiais</span></span></label>
                    </div>
                </div>
                <div class="form-group" id="detalhesEvento" hidden>
                    <label for="tipoEvento">Tipo de evento</label>
                    <select id="tipoEvento" name="tipoEvento">
                        <option value="" disabled selected>Selecione</option>
                        <option value="aniversario">Aniversário / celebração</option>
                        <option value="reuniao">Reunião de negócios</option>
                        <option value="confraternizacao">Confraternização corporativa</option>
                        <option value="outro">Outro (detalhe nas observações)</option>
                    </select>
                </div>
                <div class="form-row">
                    <div class="form-group"><label for="data">Data</label><input type="date" id="data" name="data" required></div>
                    <div class="form-group"><label for="hora">Horário</label><input type="time" id="hora" name="hora" required></div>
                </div>
                <div class="form-row">
                    <div class="form-group">
                        <label for="pessoas">Nº de pessoas</label>
                        <select id="pessoas" name="pessoas" required>
                            <option value="" disabled selected>Selecione</option>
                            <option>1 pessoa</option><option>2 pessoas</option><option>3 pessoas</option>
                            <option>4 pessoas</option><option>5 pessoas</option><option>6 pessoas</option>
                            <option value="7+">Mais de 6 (entraremos em contato)</option>
                        </select>
                    </div>
                    <div class="form-group">
                        <label for="ambiente">Preferência de ambiente</label>
                        <select id="ambiente" name="ambiente">
                            <option value="qualquer">Sem preferência</option>
                            <option value="salao">Salão principal</option>
                            <option value="varanda">Varanda externa</option>
                            <option value="privado">Sala privativa</option>
                        </select>
                    </div>
                </div>
                <div class="form-group"><label for="observacoes">Observações</label><textarea id="observacoes" name="observacoes" rows="4" placeholder="Ex.: alergias, comemoração, necessidades especiais…"></textarea></div>
                <button type="submit" class="btn btn-primary btn-block btn-reserva-submit">Enviar solicitação</button>
                <p class="form-footnote">Sua reserva será confirmada por e-mail ou telefone.</p>
            </form>
        </div>
    </div>
</section>
@section Scripts {
<script src="~/js/reservas.js" asp-append-version="true"></script>
}
