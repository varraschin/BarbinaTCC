@section Scripts {
<script>
(function () {
    // Mesma fonte de dados usada na página Ambientes (localStorage do admin),
    // garantindo que imagem e título fiquem sempre sincronizados entre as duas páginas.
    try {
        const raw = localStorage.getItem('barbina_cms_v2');
        if (!raw) return;
        const db = JSON.parse(raw);
        if (!Array.isArray(db.environments)) return;

        document.querySelectorAll('[data-ambiente-section]').forEach((card) => {
            const sectionKey = card.getAttribute('data-ambiente-section');
            const candidates = db.environments.filter((e) => !e.isCarousel && e.section === sectionKey);
            if (!candidates.length) return;
            const chosen = candidates.find((e) => e.isActive) || candidates[0];
            const img = card.querySelector('img');
            const h3 = card.querySelector('h3');
            if (img && chosen.image) img.src = chosen.image;
            if (h3 && chosen.title) h3.textContent = chosen.title;
        });
    } catch (e) {
        // Mantém as imagens/títulos padrão já presentes no HTML.
    }
})();
</script>
}

<section class="feature-section">
    <div class="container">
        <div class="feature-content">
            <div class="feature-image anim-fade-up">
                <img src="https://images.unsplash.com/photo-1559847844-5315695dadae?auto=format&fit=crop&w=1000&q=80" alt="Prato de assinatura" loading="lazy">
            </div>
            <div class="feature-text anim-fade-up">
                <div class="section-header"><h2>O Prato de Assinatura</h2></div>
                <p>Nosso Filé Mignon Barbina é selado à perfeição, regado com um molho de vinho tinto reduzido lentamente e servido sobre um cremoso risoto de parmesão.</p>
                <a href="/Home/Cardapio" class="btn btn-primary">Descubra no Cardápio</a>
