@{ ViewData["Title"] = "Cardápio | Restaurante Barbina"; Layout = "_Layout"; }

<section class="hero-page"
    style="background-image: linear-gradient(rgba(0,0,0,0.7), rgba(0,0,0,0.7)), url('@SiteImages.CardapioHero');">
    <div class="hero-content">
        <h2>Nosso Cardápio</h2>
        <p>Uma seleção de pratos refinados, preparados com arte e paixão.</p>
    </div>
</section>

<section class="menu">
    <div class="container">
        <div class="section-header">
            <h2>Obras de Arte Comestíveis</h2>
            <p>Descubra as categorias que compõem a nossa experiência gastronômica.</p>
        </div>

        <div id="menuCategoriesRoot" class="menu-categories"></div>
        <div id="menuSectionsRoot"></div>
    </div>
</section>

@section Scripts {
<script>
(function () {
    'use strict';

    // Mesma URL configurada em Barbina.UI/appsettings.json (ApiSettings:BaseUrl).
    const API_BASE = 'http://localhost:5058/api/';

    function escapeHtml(text) {
        const div = document.createElement('div');
        div.textContent = String(text ?? '');
        return div.innerHTML;
    }

    async function fetchJson(path) {
        const res = await fetch(API_BASE + path);
        if (!res.ok) throw new Error(`HTTP ${res.status}`);
        return res.json();
    }

    function buildItemHtml(item) {
        // NÃO usa anim-fade-up para evitar itens invisíveis (opacity:0 sem .visible)
        return `
            <div class="menu-item">
                <div class="item-info">
                    <h3>${escapeHtml(item.nome)}</h3>
                    <p>${escapeHtml(item.descricao)}</p>
                </div>
            </div>`;
    }

    function initCategoryButtons() {
        document.querySelectorAll('.category-btn').forEach((btn) => {
            btn.addEventListener('click', function () {
                document.querySelectorAll('.category-btn').forEach((b) => b.classList.remove('active'));
                document.querySelectorAll('.menu-items').forEach((s) => s.classList.remove('active'));
                this.classList.add('active');
                const target = document.getElementById(this.getAttribute('data-category'));
                if (target) target.classList.add('active');
            });
        });
    }

    /**
     * Ativa a categoria indicada pelo #hash da URL (ex: vindo da Home,
     * "/Home/Cardapio#cat-1"), permitindo abrir o Cardápio já posicionado
     * na categoria correta, sem o usuário precisar procurá-la.
     */
    function activateCategoryFromHash() {
        const hash = window.location.hash.replace('#', '');
        if (!hash) return;

        const targetBtn = document.querySelector(`.category-btn[data-category="${hash}"]`);
        const targetSection = document.getElementById(hash);
        if (!targetBtn || !targetSection) return;

        document.querySelectorAll('.category-btn').forEach((b) => b.classList.remove('active'));
        document.querySelectorAll('.menu-items').forEach((s) => s.classList.remove('active'));
        targetBtn.classList.add('active');
        targetSection.classList.add('active');

        // A seção alvo estava com display:none até agora (não-ativa); rolamos
        // até ela só depois de torná-la visível.
        document.querySelector('.menu')?.scrollIntoView({ behavior: 'smooth', block: 'start' });
    }

    async function renderMenu() {
        const catRoot = document.getElementById('menuCategoriesRoot');
        const secRoot = document.getElementById('menuSectionsRoot');

        let categorias, produtos;
        try {
            [categorias, produtos] = await Promise.all([fetchJson('categorias'), fetchJson('produtos')]);
        } catch (err) {
            secRoot.innerHTML = '<p class="menu-empty-msg">Não foi possível carregar o cardápio agora. Tente novamente em alguns instantes.</p>';
            return;
        }

        if (!categorias.length) {
            secRoot.innerHTML = '<p class="menu-empty-msg">Cardápio em atualização. Volte em breve!</p>';
            return;
        }

        catRoot.innerHTML = categorias
            .map((c, i) => `<button type="button" class="category-btn ${i === 0 ? 'active' : ''}" data-category="cat-${c.id}">${escapeHtml(c.nome)}</button>`)
            .join('');

        secRoot.innerHTML = categorias
            .map((c, i) => {
                const itens = produtos.filter((p) => p.categoriaId === c.id);
                const itensHtml = itens.length
                    ? itens.map(buildItemHtml).join('')
                    : '<p class="menu-empty-msg">Nenhum item cadastrado nesta categoria.</p>';
                return `<div class="menu-items ${i === 0 ? 'active' : ''}" id="cat-${c.id}">${itensHtml}</div>`;
            })
            .join('');

        initCategoryButtons();
        activateCategoryFromHash();
    }

    if (document.readyState === 'loading') {
        document.addEventListener('DOMContentLoaded', renderMenu);
    } else {
        renderMenu();
    }
})();
</script>
}
