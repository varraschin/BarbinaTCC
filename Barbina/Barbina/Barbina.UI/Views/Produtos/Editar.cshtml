@model Barbina.UI.ViewModels.ProdutoViewModel
@{ ViewData["Title"] = "Editar Produto"; Layout = "_AdminLayout"; }

<div class="card" style="max-width:700px;">
    <div class="card-header"><h3><i class="fas fa-pencil-alt" style="margin-right:10px;"></i>Editar: @Model.Nome</h3></div>
    <div class="card-body">
        <form asp-action="Editar" asp-controller="Produtos" asp-route-id="@Model.Id" method="post" enctype="multipart/form-data">
            @Html.AntiForgeryToken()
            <input type="hidden" asp-for="Id" />
            <div asp-validation-summary="ModelOnly" style="color:#dc3545;margin-bottom:16px;font-size:14px;"></div>
            <div style="display:grid;grid-template-columns:1fr 1fr;gap:16px;">
                <div class="form-group" style="grid-column:1/-1">
                    <label asp-for="CategoriaId">Categoria *</label>
                    <select asp-for="CategoriaId" asp-items="Model.Categorias"><option value="">-- Selecione --</option></select>
                </div>
                <div class="form-group" style="grid-column:1/-1">
                    <label asp-for="Nome">Nome *</label>
                    <input asp-for="Nome">
                </div>
                <div class="form-group" style="grid-column:1/-1">
                    <label asp-for="Descricao">Descrição</label>
                    <textarea asp-for="Descricao" rows="3"></textarea>
                </div>
                <div class="form-group">
                    <label asp-for="ValorVenda">Valor de Venda (R$) *</label>
                    <input asp-for="ValorVenda" type="number" step="0.01" min="0">
                </div>
                <div class="form-group">
                    <label asp-for="ValorCusto">Valor de Custo (R$) *</label>
                    <input asp-for="ValorCusto" type="number" step="0.01" min="0">
                </div>
                <div class="form-group">
                    <label asp-for="Qtde">Estoque *</label>
                    <input asp-for="Qtde" type="number" min="0">
                </div>
                <div class="form-group" style="display:flex;align-items:center;gap:10px;padding-top:30px;">
                    <input asp-for="Destaque" type="checkbox" style="width:auto;">
                    <label asp-for="Destaque" style="margin:0;cursor:pointer;">Produto em Destaque</label>
                </div>
                <div class="form-group" style="grid-column:1/-1">
                    @if (!string.IsNullOrEmpty(Model.FotoAtual))
                    {
                        <label>Foto atual</label>
                        <div style="margin-bottom:12px;"><img src="@Model.FotoAtual" style="width:80px;height:80px;object-fit:cover;border-radius:10px;" onerror="this.style.display='none'"></div>
                    }
                    <label asp-for="Foto">Nova Foto (opcional)</label>
                    <input asp-for="Foto" type="file" accept="image/*">
                </div>
            </div>
            <div style="display:flex;gap:12px;margin-top:8px;">
                <button type="submit" class="btn-primary"><i class="fas fa-save"></i> Salvar</button>
                <a href="/admin/produtos" class="btn-secondary">Cancelar</a>
            </div>
        </form>
    </div>
</div>
