@model List<Barbina.UI.DTOs.ProdutoDto>
@{ ViewData["Title"] = "Cardápio"; Layout = "_AdminLayout"; }

<div class="card">
    <div class="card-header">
        <h3><i class="fas fa-utensils" style="margin-right:10px;"></i>Produtos (@Model.Count)</h3>
        <a href="/admin/produtos/criar" class="btn-primary"><i class="fas fa-plus"></i> Novo Produto</a>
    </div>
    <div class="card-body">
        @if (!Model.Any())
        {
            <div class="empty-state">
                <div class="empty-state-icon">🍽️</div>
                <p>Nenhum produto encontrado.</p>
            </div>
        }
        else
        {
            <div class="table-responsive">
                <table class="table">
                    <thead>
                        <tr>
                            <th>Nome</th>
                            <th>Categoria</th>
                            <th>Estoque</th>
                            <th>Destaque</th>
                            <th>Ações</th>
                        </tr>
                    </thead>
                    <tbody>
                    @foreach (var p in Model)
                    {
                        <tr>
                            <td>
                                <strong>@p.Nome</strong>
                                <br>
                                <small style="color:var(--gray-text);font-size:12px;">
                                    @(p.Descricao?.Length > 70 ? p.Descricao.Substring(0, 70) + "…" : p.Descricao)
                                </small>
                            </td>
                            <td><span class="menu-item-card__cat">@p.CategoriaNome</span></td>
                            <td>@p.Qtde un.</td>
                            <td>
                                @if (p.Destaque)
                                {
                                    <span class="status-badge status-confirmed"><i class="fas fa-star"></i> Sim</span>
                                }
                                else
                                {
                                    <span style="color:var(--gray-text);font-size:13px;">Não</span>
                                }
                            </td>
                            <td class="table-actions">
                                <a href="/admin/produtos/editar/@p.Id" class="btn-icon" title="Editar">
                                    <i class="fas fa-pencil-alt"></i>
                                </a>
                                <form method="post" action="/admin/produtos/excluir/@p.Id" style="display:inline"
                                      onsubmit="return confirm('Excluir @Html.Raw(p.Nome.Replace("'", "\\'"))?')">
                                    @Html.AntiForgeryToken()
                                    <button type="submit" class="btn-icon danger" title="Excluir">
                                        <i class="fas fa-trash"></i>
                                    </button>
                                </form>
                            </td>
                        </tr>
                    }
                    </tbody>
                </table>
            </div>
        }
    </div>
</div>
