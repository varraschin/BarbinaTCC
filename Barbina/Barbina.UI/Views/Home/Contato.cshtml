@{ ViewData["Title"] = "Contato"; Layout = "_Layout"; }
<section class="hero-page" style="background-image: linear-gradient(rgba(0,0,0,0.7), rgba(0,0,0,0.7)), url('@SiteImages.ContatoHero');">
    <div class="hero-content"><h2>Fale Conosco</h2><p>Estamos ansiosos para ouvir você e responder suas dúvidas.</p></div>
</section>
<section class="contato-info">
    <div class="container">
        <div class="section-header"><h2>Informações Essenciais</h2><p>Entre em contato por telefone, e-mail ou venha nos visitar.</p></div>
        <div class="info-grid">
            <div class="info-card anim-fade-up">
                <i class="fas fa-map-marker-alt"></i><h3>Localização</h3>
                <p>Av. Pedro Ometto, 700 - Centro, Barra Bonita - SP, 17340-001</p>
                <a href="https://maps.google.com/?q=Av.+Pedro+Ometto,+700,+Barra+Bonita,+SP" target="_blank">Ver no Mapa</a>
            </div>
            <div class="info-card anim-fade-up">
                <i class="fas fa-phone"></i><h3>Telefone</h3>
                <p>Reservas e informações: (14) 3438-1255</p>
            </div>
            <div class="info-card anim-fade-up">
                <i class="fas fa-envelope"></i><h3>E-mail</h3>
                <p>contato@barbina.com</p><p>reservas@barbina.com</p>
            </div>
        </div>
    </div>
</section>
<section class="mapa-localizacao">
    <div class="container">
        <iframe src="https://www.google.com/maps/embed?pb=!1m18!1m12!1m3!1d3692.569426217462!2d-48.5599868845304!3d-22.4925821278149!2m3!1f0!2f0!3f0!3m2!1i1024!2i768!4f13.1!3m3!1m2!1s0x94c7455d3a5e1867%3A0x67b57906b3a5d8a8!2sAv.+Pedro+Ometto%2C+700+-+Centro%2C+Barra+Bonita+-+SP!5e0!3m2!1spt-BR!2sbr!4v1666543210987" allowfullscreen="" loading="lazy" referrerpolicy="no-referrer-when-downgrade"></iframe>
    </div>
</section>
<section class="faq">
    <div class="container">
        <div class="section-header"><h2>Perguntas Frequentes</h2><p>Respostas rápidas para as dúvidas mais comuns.</p></div>
        <div class="faq-list">
            <div class="faq-item anim-fade-up"><div class="faq-pergunta"><h3>Qual o horário de funcionamento?</h3><i class="fas fa-chevron-down"></i></div><div class="faq-resposta"><p>Funcionamos de quarta a sexta das 17h às 23:30h, aos sábados das 11h às 23:30h e aos domingos das 11h às 15h.</p></div></div>
            <div class="faq-item anim-fade-up"><div class="faq-pergunta"><h3>Precisa fazer reserva?</h3><i class="fas fa-chevron-down"></i></div><div class="faq-resposta"><p>Recomendamos fortemente as reservas, especialmente aos fins de semana e para grupos grandes.</p></div></div>
            <div class="faq-item anim-fade-up"><div class="faq-pergunta"><h3>Tem opções vegetarianas/veganas?</h3><i class="fas fa-chevron-down"></i></div><div class="faq-resposta"><p>Sim! Nosso chef preparou diversas opções vegetarianas e veganas. Consulte o cardápio ou nosso staff.</p></div></div>
            <div class="faq-item anim-fade-up"><div class="faq-pergunta"><h3>O restaurante possui estacionamento?</h3><i class="fas fa-chevron-down"></i></div><div class="faq-resposta"><p>Sim, oferecemos serviço de valet e estacionamento conveniado próximo ao local.</p></div></div>
        </div>
    </div>
</section>
