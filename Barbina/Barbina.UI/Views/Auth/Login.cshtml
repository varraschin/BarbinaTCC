@model Barbina.UI.ViewModels.LoginViewModel
@{ ViewData["Title"] = "Login Administrativo"; Layout = null; }
<!DOCTYPE html>
<html lang="pt-BR">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Barbina CMS | Login</title>
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700&family=Playfair+Display:wght@400;600;700&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.1/css/all.min.css">
    <link rel="stylesheet" href="~/css/admin-style.css" asp-append-version="true">
    <style>
        body { display:flex; align-items:center; justify-content:center; min-height:100vh; background:var(--dark-bg); }
        .login-card { background:var(--dark-card); border-radius:24px; padding:48px 40px; width:100%; max-width:420px; border:1px solid var(--border-light); }
        .login-logo { text-align:center; margin-bottom:36px; }
        .login-logo .logo-icon { font-size:40px; color:var(--gold); display:block; margin-bottom:12px; }
        .login-logo h1 { font-family:'Playfair Display',serif; font-size:2rem; color:var(--off-white); margin:0; }
        .login-logo span { font-size:.8rem; color:var(--gray-text); letter-spacing:2px; text-transform:uppercase; }
        .login-card h2 { font-size:1.4rem; margin-bottom:28px; font-weight:600; color: var(--off-white); }
        .error-msg { background:rgba(220,53,69,.15); border:1px solid rgba(220,53,69,.35); color:#ff6b7a; border-radius:12px; padding:14px 18px; font-size:14px; margin-bottom:20px; display:flex; align-items:center; gap:10px; }
        .form-footer { margin-top:16px; text-align:center; font-size:13px; color:var(--gray-text); }
        .form-footer a { color:var(--gold); text-decoration:none; }
        .form-footer a:hover { text-decoration:underline; }
    </style>
</head>
<body>
    <div class="login-card">
        <div class="login-logo">
            <span class="logo-icon">✦</span>
            <h1>Barbina</h1>
            <span>Painel Administrativo</span>
        </div>
        <h2>Entrar</h2>

        @if (!string.IsNullOrEmpty(Model.ErrorMessage))
        {
            <div class="error-msg"><i class="fas fa-exclamation-circle"></i> @Model.ErrorMessage</div>
        }

        <form method="post" action="/admin/auth/login">
            <input type="hidden" asp-for="ReturnUrl" />
            @Html.AntiForgeryToken()
            <div class="form-group">
                <label asp-for="Email">E-mail</label>
                <input asp-for="Email" type="email"
                       placeholder="Seu e-mail" autocomplete="email"
                       required maxlength="256">
                <span asp-validation-for="Email" style="color:#ff6b7a;font-size:12px;"></span>
            </div>
            <div class="form-group">
                <label asp-for="Senha">Senha</label>
                <input asp-for="Senha" type="password"
                       placeholder="••••••••" autocomplete="current-password"
                       required minlength="6" maxlength="100">
                <span asp-validation-for="Senha" style="color:#ff6b7a;font-size:12px;"></span>
            </div>
            <button type="submit" class="btn-primary" style="width:100%;margin-top:8px;border-radius:14px;padding:14px;font-size:15px;">
                <i class="fas fa-sign-in-alt" style="margin-right:8px;"></i> Entrar
            </button>
        </form>
        <div class="form-footer">
            <a href="/">← Voltar ao site público</a>
        </div>
    </div>
</body>
</html>
