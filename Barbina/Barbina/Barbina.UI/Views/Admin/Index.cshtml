@{ ViewData["Title"] = "Dashboard"; Layout = "_AdminLayout"; }

<div class="kpi-grid">
    <div class="kpi-card">
        <div class="kpi-icon"><i class="fas fa-utensils"></i></div>
        <div class="kpi-value">@(ViewBag.TotalProdutos ?? 0)</div>
        <div class="kpi-label">Produtos no Cardápio</div>
    </div>
    <div class="kpi-card">
        <div class="kpi-icon"><i class="fas fa-tags"></i></div>
        <div class="kpi-value">@(ViewBag.TotalCategorias ?? 0)</div>
        <div class="kpi-label">Categorias</div>
    </div>
    <div class="kpi-card">
        <div class="kpi-icon"><i class="fas fa-boxes"></i></div>
        <div class="kpi-value">@(ViewBag.TotalEstoque ?? 0)</div>
        <div class="kpi-label">Itens em Estoque</div>
    </div>
    <div class="kpi-card">
        <div class="kpi-icon"><i class="fas fa-star"></i></div>
        <div class="kpi-value">@(ViewBag.Destaques ?? 0)</div>
        <div class="kpi-label">Pratos em Destaque</div>
    </div>
</div>

<div class="two-col-grid">
    <div class="card">
        <div class="card-header">
            <h3>Acesso Rápido</h3>
            <i class="fas fa-bolt"></i>
        </div>
        <div class="card-body" style="display:flex;flex-direction:column;gap:12px;">
            <a href="/admin/produtos/criar" class="btn-primary" style="text-align:center;text-decoration:none;padding:12px;border-radius:12px;display:block;">
                <i class="fas fa-plus"></i> Novo Produto
            </a>
            <a href="/admin/categorias/criar" class="btn-secondary" style="text-align:center;text-decoration:none;padding:12px;border-radius:12px;display:block;">
                <i class="fas fa-folder-plus"></i> Nova Categoria
            </a>
            <a href="/admin/produtos" class="btn-secondary" style="text-align:center;text-decoration:none;padding:12px;border-radius:12px;display:block;">
                <i class="fas fa-list"></i> Ver todos os Produtos
            </a>
            <a href="/" target="_blank" class="btn-secondary" style="text-align:center;text-decoration:none;padding:12px;border-radius:12px;display:block;">
                <i class="fas fa-external-link-alt"></i> Ver site público
            </a>
        </div>
    </div>
    <div class="card">
        <div class="card-header">
            <h3>Informações do Sistema</h3>
            <i class="fas fa-info-circle"></i>
        </div>
        <div class="card-body">
            <div class="activity-item">
                <div class="activity-icon"><i class="fas fa-user"></i></div>
                <div class="activity-text">
                    <p>Usuário logado</p>
                    <span class="activity-time">@(ViewBag.AdminNome ?? "Administrador")</span>
                </div>
            </div>
            <div class="activity-item">
                <div class="activity-icon"><i class="fas fa-calendar"></i></div>
                <div class="activity-text">
                    <p>Data atual</p>
                    <span class="activity-time">@DateTime.Now.ToString("dd/MM/yyyy HH:mm")</span>
                </div>
            </div>
            <div class="activity-item">
                <div class="activity-icon"><i class="fas fa-dollar-sign"></i></div>
                <div class="activity-text">
                    <p>Valor total do cardápio</p>
                    <span class="activity-time">R$ @(ViewBag.ValorEstoque != null ? ((decimal)ViewBag.ValorEstoque).ToString("N2") : "0,00")</span>
                </div>
            </div>
        </div>
    </div>
</div>
