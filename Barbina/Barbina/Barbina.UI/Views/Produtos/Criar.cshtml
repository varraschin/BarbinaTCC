@model Barbina.UI.ViewModels.ProdutoViewModel
@{ ViewData["Title"] = "Novo Produto"; Layout = "_AdminLayout"; }

<div class="card" style="max-width:700px;">
    <div class="card-header"><h3><i class="fas fa-plus-circle" style="margin-right:10px;"></i>Novo Produto</h3></div>
    <div class="card-body">
        <form asp-action="Criar" asp-controller="Produtos" method="post" enctype="multipart/form-data">
            @Html.AntiForgeryToken()
            <div asp-validation-summary="ModelOnly" style="color:#dc3545;margin-bottom:16px;font-size:14px;"></div>
            <div style="display:grid;grid-template-columns:1fr 1fr;gap:16px;">
                <div class="form-group" style="grid-column:1/-1">
                    <label asp-for="CategoriaId">Categoria *</label>
                    <select asp-for="CategoriaId" asp-items="Model.Categorias">
                        <option value="">-- Selecione --</option>
                    </select>
                    <span asp-validation-for="CategoriaId" style="color:#dc3545;font-size:12px;"></span>
                </div>
                <div class="form-group" style="grid-column:1/-1">
                    <label asp-for="Nome">Nome do Produto *</label>
                    <input asp-for="Nome" placeholder="Ex: Filé Mignon Barbina">
                    <span asp-validation-for="Nome" style="color:#dc3545;font-size:12px;"></span>
                </div>
                <div class="form-group" style="grid-column:1/-1">
                    <label asp-for="Descricao">Descrição</label>
                    <textarea asp-for="Descricao" rows="3" placeholder="Descreva o prato..."></textarea>
                </div>
                <div class="form-group">
                    <label asp-for="ValorVenda">Valor de Venda (R$) *</label>
                    <input asp-for="ValorVenda" type="number" step="0.01" min="0" placeholder="0,00">
                    <span asp-validation-for="ValorVenda" style="color:#dc3545;font-size:12px;"></span>
                </div>
                <div class="form-group">
                    <label asp-for="ValorCusto">Valor de Custo (R$) *</label>
                    <input asp-for="ValorCusto" type="number" step="0.01" min="0" placeholder="0,00">
                </div>
                <div class="form-group">
                    <label asp-for="Qtde">Estoque *</label>
                    <input asp-for="Qtde" type="number" min="0" placeholder="0">
                </div>
                <div class="form-group" style="display:flex;align-items:center;gap:10px;padding-top:30px;">
                    <input asp-for="Destaque" type="checkbox" style="width:auto;">
                    <label asp-for="Destaque" style="margin:0;cursor:pointer;">Produto em Destaque</label>
                </div>
                <div class="form-group" style="grid-column:1/-1">
                    <label asp-for="Foto">Foto do Produto</label>
                    <input asp-for="Foto" type="file" accept="image/*">
                </div>
            </div>
            <div style="display:flex;gap:12px;margin-top:8px;">
                <button type="submit" class="btn-primary"><i class="fas fa-save"></i> Salvar</button>
                <a href="/admin/produtos" class="btn-secondary">Cancelar</a>
            </div>
        </form>
    </div>
</div>
